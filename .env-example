STEVILLIS_SITE_SECRET_KEY=your-secret-key-here
STEVILLIS_SITE_RUNNING_LOCAL=True
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,learning.stevillis.com.br

# Database configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=stevillis
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Fallback PG variables for compatibility
PGDATABASE=stevillis
PGUSER=postgres
PGPASSWORD=postgres
PGHOST=127.0.0.1
PGPORT=5432
